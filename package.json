{
	"name": "headways",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"cap:build": "npm run build && npm run cap:fixpaths && npx cap sync",
		"cap:ios": "npm run build && npm run cap:fixpaths && npx cap sync && npx cap open ios",
		"cap:fixpaths": "sed -i '' 's|href=\"/|href=\"./|g; s|src=\"/|src=\"./|g; s|import(\"/|import(\"./|g' build/index.html"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^6.2.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/leaflet": "^1.9.21",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@capacitor/cli": "^8.4.2",
		"@capacitor/core": "^8.4.2",
		"@capacitor/ios": "^8.4.2",
		"leaflet": "^1.9.4",
		"projektpro-leaflet-smoothwheelzoom": "^0.1.4"
	}
}
